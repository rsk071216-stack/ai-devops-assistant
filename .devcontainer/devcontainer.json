{
  "name": "ai-devops-assistant",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm@sha256:7876580dc67fd460fd962f004cbeb480027e9bbc0657096f1087db11f9eaff39",
  "containerEnv": {
    "UV_LINK_MODE": "copy"
  },
  "postCreateCommand": "pipx install uv==0.13.0 && uv sync --frozen --all-extras",
  "customizations": {
    "vscode": {
      "extensions": [
        "charliermarsh.ruff",
        "ms-python.python",
        "redhat.vscode-yaml",
        "github.vscode-github-actions"
      ]
    }
  }
}
